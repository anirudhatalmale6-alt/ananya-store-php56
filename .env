APP_NAME=Ananya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ananya
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Drivers — "file" / "sync" keep the app dependency-free on shared hosting.
# ---------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# ---------------------------------------------------------------------------
# Mail
#
# Order notifications are sent with PHP's native mail() function by
# App\Services\OrderMailer — no SMTP account or third-party service is used.
# These values only set the From/Reply-To identity on those messages.
# ---------------------------------------------------------------------------
MAIL_DRIVER=mail
MAIL_FROM_ADDRESS=no-reply@ananya.com
MAIL_FROM_NAME=Ananya

# Administrator inbox that receives a copy of every order + status email.
ADMIN_EMAIL=admin@ananya.com

# ---------------------------------------------------------------------------
# Storefront
# ---------------------------------------------------------------------------
STORE_CURRENCY=LKR
STORE_CURRENCY_CODE=LKR
STORE_TAGLINE="Where Tradition Meets Excellence"
